; NVT run that writes the charge current on the fly (userint1 = output interval in steps, read by the on-the-fly module)
; @T@ is filled in by ecacf_workflow.sh
title                = NVT run with on-the-fly current output
constraints          = h-bonds
integrator           = md
dt                   = 0.002
nsteps               = 100000           ; 200 ps
nstcomm              = 1
nstcalcenergy        = 1
nstxout              = 10000
nstvout              = 0
nstfout              = 0
nstlog               = 10000
nstenergy            = 10000
userint1             = 5                ; one current sample every 5 steps (10 fs)
userint2             = 5
nstxout-compressed   = 500

cutoff-scheme        = Verlet
nstlist              = 10
coulombtype          = PME
rlist                = 1.2
rcoulomb             = 1.2
vdwtype              = Cut-off
rvdw                 = 1.2
fourierspacing       = 0.1
pme_order            = 4
ewald_rtol           = 1e-5
ewald_geometry       = 3d
DispCorr             = EnerPres

Tcoupl               = nose-hoover
tc-grps              = System
tau_t                = 1
ref_t                = @T@
nhchainlength        = 1

Pcoupl               = no
