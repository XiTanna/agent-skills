; NPT run with a single heating/cooling cycle, used to decorrelate independent starting boxes
; @T@ = target temperature (K), @PEAK@ = annealing peak temperature (K); both are filled in by ecacf_workflow.sh
title                = decorrelation NPT with annealing
constraints          = h-bonds
integrator           = md
dt                   = 0.002
nsteps               = 1000000          ; 2 ns
nstcomm              = 1
nstcalcenergy        = 1
nstxout              = 10000            ; the trr (coordinates + velocities) is used to pick starting frames
nstvout              = 1000
nstfout              = 0
nstlog               = 10000
nstenergy            = 10000
nstxout-compressed   = 500

; electrostatics and van der Waals (nm)
cutoff-scheme        = Verlet
nstlist              = 10
coulombtype          = PME
rlist                = 1.2
rcoulomb             = 1.2
vdwtype              = Cut-off
rvdw                 = 1.2
fourierspacing       = 0.1
pme_order            = 4
ewald_rtol           = 1e-5
ewald_geometry       = 3d
DispCorr             = EnerPres

Tcoupl               = nose-hoover
tc-grps              = System
tau_t                = 1
ref_t                = @T@
nhchainlength        = 1

Pcoupl               = parrinello-rahman
Pcoupltype           = isotropic
tau_p                = 20.0
compressibility      = 4.5e-5
ref_p                = 1.0

annealing            = single
annealing_npoints    = 4
annealing_time       = 0 500 1000 2000
annealing_temp       = @T@ @PEAK@ @T@ @T@
