#!/bin/bash
#SBATCH --job-name=CASENAME-TEMPK
#SBATCH -A ACCOUNT
#SBATCH -p PARTITION
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=6
#SBATCH --mem=40g
#SBATCH --time=4:00:00
#SBATCH --gres=gpu:1

# >>> environment: filled in by bulk_electrolyte.sh from $GMX_SETUP (e.g. "module load gromacs" or "source /path/GMXRC")
#GMX_ENV_SETUP#

ncores=6
name1=npt
gmx grompp -f grompp_npt.mdp -p topol.top -c min.gro -o $name1 -n index.ndx -maxwarn 3
gmx mdrun -s $name1 -deffnm $name1 -v -ntmpi 1 -ntomp $ncores -cpi -pme gpu -nb gpu -pmefft gpu -pinoffset 1 -tunepme no
